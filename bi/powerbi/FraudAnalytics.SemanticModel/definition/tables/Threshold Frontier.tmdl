table 'Threshold Frontier'
	lineageTag: 7fe6902c-869c-577b-99af-ce19e261c523

	measure 'Selected threshold' = SELECTEDVALUE('Threshold Frontier'[decline_threshold])
		formatString: 0.00
		lineageTag: 06b3e6c1-55e8-53dd-9226-d1cb7e054a5c
		displayFolder: Operating point

	measure 'Net benefit' = SUM('Threshold Frontier'[net_benefit])
		formatString: #,0
		lineageTag: 00daaefe-8cfc-53ee-a9b3-710e62dd553b
		displayFolder: Operating point

	measure 'Net benefit at production' = CALCULATE(SUM('Threshold Frontier'[net_benefit]), ALL('Threshold Frontier'), 'Threshold Frontier'[decline_threshold] = 0.85)
		formatString: #,0
		lineageTag: b5ab0ba1-4d04-53ed-aa20-ab7b2e6d9eb0
		displayFolder: Operating point
		description: 0.85 is the swept point nearest the production threshold of 0.86.

	measure 'Net benefit vs production' = [Net benefit] - [Net benefit at production]
		formatString: +#,0;-#,0;0
		lineageTag: cc468075-a97a-52d5-920a-07b9f2c5568e
		displayFolder: Operating point

	measure 'Frontier detection rate' = SUM('Threshold Frontier'[detection_rate])
		formatString: 0.0%
		lineageTag: 4076f421-deaa-59da-adc0-f51dd769a85f
		displayFolder: Operating point

	measure 'Frontier value detection' = SUM('Threshold Frontier'[value_detection_rate])
		formatString: 0.0%
		lineageTag: 272c6c0d-cf5b-52c4-a943-fc6198fdbdc9
		displayFolder: Operating point

	measure 'Frontier precision' = SUM('Threshold Frontier'[precision])
		formatString: 0.0%
		lineageTag: a78a538e-c044-5060-93d9-ea28c4b4fc72
		displayFolder: Operating point

	measure 'Frontier false declines' = SUM('Threshold Frontier'[false_declines])
		formatString: #,0
		lineageTag: 6c987aca-7159-5c6f-b04b-be1aadbf5fc6
		displayFolder: Operating point

	measure 'Frontier alerts per 10k' = SUM('Threshold Frontier'[alerts_per_10k_score_only])
		formatString: #,0.0
		lineageTag: a7acc8c4-e8cf-577d-b7dd-4890106b7970
		displayFolder: Operating point
		description: Score-only alert load. Distinct from the alerts_per_10k KPI, which counts the realised queue including rule escalations.

